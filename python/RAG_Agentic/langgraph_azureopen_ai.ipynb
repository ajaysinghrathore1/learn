from typing import TypedDict, Annotated
from langchain_core.prompts import ChatPromptTemplate
from langchain_openai import AzureChatOpenAI
from langgraph.graph import StateGraph, END
from langgraph.graph.message import add_messages
from langchain_core.messages import BaseMessage
import asyncio

# Initialize your LLM
llm = AzureChatOpenAI(
    api_key="your-api-key",
    api_version="2024-02-15-preview",
    azure_endpoint="https://your-resource.openai.azure.com",
    deployment_name="your-gpt4-deployment"
)

# Method 1: Simple Translation Graph
print("=== Method 1: Simple Translation Graph ===")

class TranslationState(TypedDict):
    input_language: str
    output_language: str
    input_text: str
    translated_text: str
    messages: Annotated[list[BaseMessage], add_messages]

def translate_node(state: TranslationState) -> TranslationState:
    """Node that performs the translation"""
    prompt = ChatPromptTemplate.from_messages([
        ("system", f"You are a helpful assistant that translates {state['input_language']} to {state['output_language']}."),
        ("human", "{input}"),
    ])
    
    chain = prompt | llm
    result = chain.invoke({"input": state["input_text"]})
    
    return {
        **state,
        "translated_text": result.content
    }

# Build the graph
workflow = StateGraph(TranslationState)
workflow.add_node("translate", translate_node)
workflow.set_entry_point("translate")
workflow.add_edge("translate", END)

# Compile the graph
translation_graph = workflow.compile()

# Test the simple graph
result = translation_graph.invoke({
    "input_language": "English",
    "output_language": "German",
    "input_text": "I love programming.",
    "translated_text": "",
    "messages": []
})
print(f"Simple translation: {result['translated_text']}")

# Method 2: Multi-step Translation Graph with Validation
print("\n=== Method 2: Multi-step Translation Graph ===")

class AdvancedTranslationState(TypedDict):
    input_language: str
    output_language: str
    input_text: str
    validated_input: str
    translated_text: str
    quality_score: float
    messages: Annotated[list[BaseMessage], add_messages]

def validate_input_node(state: AdvancedTranslationState) -> AdvancedTranslationState:
    """Validate and clean the input text"""
    input_text = state["input_text"].strip()
    
    # Simple validation logic
    if len(input_text) == 0:
        raise ValueError("Input text cannot be empty")
    
    # Clean the input (remove extra spaces, etc.)
    cleaned_input = " ".join(input_text.split())
    
    return {
        **state,
        "validated_input": cleaned_input
    }

def translate_node_advanced(state: AdvancedTranslationState) -> AdvancedTranslationState:
    """Advanced translation node"""
    prompt = ChatPromptTemplate.from_messages([
        ("system", f"You are a professional translator. Translate the following {state['input_language']} text to {state['output_language']}. Provide only the translation, no explanations."),
        ("human", "{input}"),
    ])
    
    chain = prompt | llm
    result = chain.invoke({"input": state["validated_input"]})
    
    return {
        **state,
        "translated_text": result.content.strip()
    }

def quality_check_node(state: AdvancedTranslationState) -> AdvancedTranslationState:
    """Check translation quality"""
    prompt = ChatPromptTemplate.from_messages([
        ("system", "Rate the quality of this translation on a scale of 0-1 (1 being perfect). Respond with only a number between 0 and 1."),
        ("human", f"Original ({state['input_language']}): {state['validated_input']}\nTranslation ({state['output_language']}): {state['translated_text']}"),
    ])
    
    chain = prompt | llm
    result = chain.invoke({})
    
    try:
        quality_score = float(result.content.strip())
        quality_score = max(0, min(1, quality_score))  # Clamp between 0 and 1
    except ValueError:
        quality_score = 0.5  # Default score if parsing fails
    
    return {
        **state,
        "quality_score": quality_score
    }

def should_retry_translation(state: AdvancedTranslationState) -> str:
    """Conditional edge: decide whether to retry translation"""
    if state["quality_score"] < 0.7:
        return "retry"
    return "end"

def retry_translation_node(state: AdvancedTranslationState) -> AdvancedTranslationState:
    """Retry translation with different prompt"""
    prompt = ChatPromptTemplate.from_messages([
        ("system", f"You are an expert translator. The previous translation quality was low. Please provide a high-quality translation from {state['input_language']} to {state['output_language']}."),
        ("human", "{input}"),
    ])
    
    chain = prompt | llm
    result = chain.invoke({"input": state["validated_input"]})
    
    return {
        **state,
        "translated_text": result.content.strip(),
        "quality_score": 0.8  # Assume retry improves quality
    }

# Build advanced graph
advanced_workflow = StateGraph(AdvancedTranslationState)

# Add nodes
advanced_workflow.add_node("validate", validate_input_node)
advanced_workflow.add_node("translate", translate_node_advanced)
advanced_workflow.add_node("quality_check", quality_check_node)
advanced_workflow.add_node("retry_translate", retry_translation_node)

# Define the flow
advanced_workflow.set_entry_point("validate")
advanced_workflow.add_edge("validate", "translate")
advanced_workflow.add_edge("translate", "quality_check")

# Conditional edge based on quality
advanced_workflow.add_conditional_edges(
    "quality_check",
    should_retry_translation,
    {
        "retry": "retry_translate",
        "end": END
    }
)
advanced_workflow.add_edge("retry_translate", END)

# Compile advanced graph
advanced_translation_graph = advanced_workflow.compile()

# Test advanced graph
result = advanced_translation_graph.invoke({
    "input_language": "English",
    "output_language": "German",
    "input_text": "I love programming.",
    "validated_input": "",
    "translated_text": "",
    "quality_score": 0.0,
    "messages": []
})
print(f"Advanced translation: {result['translated_text']}")
print(f"Quality score: {result['quality_score']}")

# Method 3: Multi-language Translation Graph
print("\n=== Method 3: Multi-language Translation Graph ===")

class MultiTranslationState(TypedDict):
    input_language: str
    input_text: str
    target_languages: list[str]
    translations: dict[str, str]
    messages: Annotated[list[BaseMessage], add_messages]

def translate_to_language(language: str):
    """Create a translation node for a specific language"""
    def translate_node(state: MultiTranslationState) -> MultiTranslationState:
        prompt = ChatPromptTemplate.from_messages([
            ("system", f"Translate the following {state['input_language']} text to {language}:"),
            ("human", "{input}"),
        ])
        
        chain = prompt | llm
        result = chain.invoke({"input": state["input_text"]})
        
        translations = state.get("translations", {})
        translations[language] = result.content.strip()
        
        return {
            **state,
            "translations": translations
        }
    return translate_node

def route_to_languages(state: MultiTranslationState) -> list[str]:
    """Route to translation nodes based on target languages"""
    return [f"translate_to_{lang.lower()}" for lang in state["target_languages"]]

# Build multi-language graph
multi_workflow = StateGraph(MultiTranslationState)

# Add translation nodes for different languages
languages = ["German", "French", "Spanish", "Italian"]
for lang in languages:
    multi_workflow.add_node(f"translate_to_{lang.lower()}", translate_to_language(lang))

# Set up routing (this is a simplified version - in practice you'd use conditional edges)
multi_workflow.set_entry_point("translate_to_german")  # Simplified for demo

# Add edges
multi_workflow.add_edge("translate_to_german", "translate_to_french")
multi_workflow.add_edge("translate_to_french", END)

# Compile multi-language graph
multi_translation_graph = multi_workflow.compile()

# Test multi-language (simplified demo)
result = multi_translation_graph.invoke({
    "input_language": "English",
    "input_text": "I love programming.",
    "target_languages": ["German", "French"],
    "translations": {},
    "messages": []
})
print(f"Multi-language translations: {result['translations']}")

# Method 4: Async LangGraph Translation
print("\n=== Method 4: Async LangGraph Translation ===")

async def async_translate_node(state: TranslationState) -> TranslationState:
    """Async translation node"""
    prompt = ChatPromptTemplate.from_messages([
        ("system", f"You are a helpful assistant that translates {state['input_language']} to {state['output_language']}."),
        ("human", "{input}"),
    ])
    
    chain = prompt | llm
    result = await chain.ainvoke({"input": state["input_text"]})
    
    return {
        **state,
        "translated_text": result.content
    }

# Build async graph
async_workflow = StateGraph(TranslationState)
async_workflow.add_node("async_translate", async_translate_node)
async_workflow.set_entry_point("async_translate")
async_workflow.add_edge("async_translate", END)

# Compile async graph
async_translation_graph = async_workflow.compile()

# Test async graph
async def test_async_translation():
    result = await async_translation_graph.ainvoke({
        "input_language": "English",
        "output_language": "German",
        "input_text": "I love programming.",
        "translated_text": "",
        "messages": []
    })
    print(f"Async translation: {result['translated_text']}")

# Run async test
asyncio.run(test_async_translation())

# Method 5: Streaming LangGraph Translation
print("\n=== Method 5: Streaming LangGraph Translation ===")

def streaming_translate_node(state: TranslationState) -> TranslationState:
    """Translation node that can be used with streaming"""
    prompt = ChatPromptTemplate.from_messages([
        ("system", f"You are a helpful assistant that translates {state['input_language']} to {state['output_language']}."),
        ("human", "{input}"),
    ])
    
    chain = prompt | llm
    result = chain.invoke({"input": state["input_text"]})
    
    return {
        **state,
        "translated_text": result.content
    }

# Build streaming graph
streaming_workflow = StateGraph(TranslationState)
streaming_workflow.add_node("stream_translate", streaming_translate_node)
streaming_workflow.set_entry_point("stream_translate")
streaming_workflow.add_edge("stream_translate", END)

# Compile streaming graph
streaming_translation_graph = streaming_workflow.compile()

# Test streaming
print("Streaming translation steps:")
for step in streaming_translation_graph.stream({
    "input_language": "English",
    "output_language": "German", 
    "input_text": "I love programming.",
    "translated_text": "",
    "messages": []
}):
    print(f"Step: {step}")

# Method 6: Interactive Translation Graph with Human-in-the-loop
print("\n=== Method 6: Human-in-the-loop Translation (Conceptual) ===")

class InteractiveTranslationState(TypedDict):
    input_language: str
    output_language: str
    input_text: str
    translated_text: str
    human_feedback: str
    requires_human_review: bool
    messages: Annotated[list[BaseMessage], add_messages]

def translate_with_confidence(state: InteractiveTranslationState) -> InteractiveTranslationState:
    """Translation node that flags uncertain translations"""
    prompt = ChatPromptTemplate.from_messages([
        ("system", f"Translate {state['input_language']} to {state['output_language']}. If you're unsure about the translation, start your response with 'UNCERTAIN:'."),
        ("human", "{input}"),
    ])
    
    chain = prompt | llm
    result = chain.invoke({"input": state["input_text"]})
    
    requires_review = result.content.startswith("UNCERTAIN:")
    translated_text = result.content.replace("UNCERTAIN:", "").strip()
    
    return {
        **state,
        "translated_text": translated_text,
        "requires_human_review": requires_review
    }

def human_review_node(state: InteractiveTranslationState) -> InteractiveTranslationState:
    """Node for human review (simulated)"""
    # In a real implementation, this would pause for human input
    print(f"Human review needed for: {state['translated_text']}")
    # Simulate human approval
    return {
        **state,
        "human_feedback": "Approved",
        "requires_human_review": False
    }

def needs_human_review(state: InteractiveTranslationState) -> str:
    """Decide if human review is needed"""
    if state["requires_human_review"]:
        return "human_review"
    return "end"

# Build interactive graph
interactive_workflow = StateGraph(InteractiveTranslationState)
interactive_workflow.add_node("translate_with_confidence", translate_with_confidence)
interactive_workflow.add_node("human_review", human_review_node)

interactive_workflow.set_entry_point("translate_with_confidence")
interactive_workflow.add_conditional_edges(
    "translate_with_confidence",
    needs_human_review,
    {
        "human_review": "human_review",
        "end": END
    }
)
interactive_workflow.add_edge("human_review", END)

# Compile interactive graph
interactive_translation_graph = interactive_workflow.compile()

# Test interactive graph
result = interactive_translation_graph.invoke({
    "input_language": "English",
    "output_language": "German",
    "input_text": "I love programming.",
    "translated_text": "",
    "human_feedback": "",
    "requires_human_review": False,
    "messages": []
})
print(f"Interactive translation result: {result['translated_text']}")
print(f"Required human review: {result['requires_human_review']}")

