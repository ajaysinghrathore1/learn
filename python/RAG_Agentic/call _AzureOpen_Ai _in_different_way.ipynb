from langchain_core.prompts import ChatPromptTemplate
from langchain_openai import AzureChatOpenAI
import asyncio

# Initialize your LLM
llm = AzureChatOpenAI(
    api_key="your-api-key",
    api_version="2024-02-15-preview",
    azure_endpoint="https://your-resource.openai.azure.com",
    deployment_name="your-gpt4-deployment"
)

# Create the prompt template
prompt = ChatPromptTemplate.from_messages([
    ("system", "You are a helpful assistant that translates {input_language} to {output_language}."),
    ("human", "{input}"),
])

# Method 1: Original Pipe Operator (|)
print("=== Method 1: Pipe Operator ===")
chain = prompt | llm
result = chain.invoke({
    "input_language": "English",
    "output_language": "German", 
    "input": "I love programming."
})
print(result.content)

# Method 2: Using .compose() method
print("\n=== Method 2: Compose Method ===")
chain = prompt.pipe(llm)  # or prompt.compose(llm)
result = chain.invoke({
    "input_language": "English",
    "output_language": "German",
    "input": "I love programming."
})
print(result.content)

# Method 3: Manual step-by-step execution
print("\n=== Method 3: Manual Step-by-Step ===")
# Format the prompt first
formatted_prompt = prompt.format_prompt(
    input_language="English",
    output_language="German", 
    input="I love programming."
)
# Then invoke the LLM
result = llm.invoke(formatted_prompt.to_messages())
print(result.content)

# Method 4: Using LLMChain (legacy but still works)
print("\n=== Method 4: LLMChain (Legacy) ===")
from langchain.chains import LLMChain
from langchain_core.prompts import PromptTemplate

# Convert to simple prompt template for LLMChain
simple_prompt = PromptTemplate(
    input_variables=["input_language", "output_language", "input"],
    template="Translate the following {input_language} text to {output_language}: {input}"
)

llm_chain = LLMChain(llm=llm, prompt=simple_prompt)
result = llm_chain.run(
    input_language="English",
    output_language="German",
    input="I love programming."
)
print(result)

# Method 5: Using RunnableSequence explicitly
print("\n=== Method 5: RunnableSequence ===")
from langchain_core.runnables import RunnableSequence

chain = RunnableSequence(first=prompt, middle=[], last=llm)
result = chain.invoke({
    "input_language": "English", 
    "output_language": "German",
    "input": "I love programming."
})
print(result.content)

# Method 6: Using batch processing
print("\n=== Method 6: Batch Processing ===")
chain = prompt | llm
inputs = [
    {"input_language": "English", "output_language": "German", "input": "I love programming."},
    {"input_language": "English", "output_language": "French", "input": "Hello world."},
    {"input_language": "Spanish", "output_language": "English", "input": "Hola mundo."}
]
results = chain.batch(inputs)
for i, result in enumerate(results):
    print(f"Translation {i+1}: {result.content}")

# Method 7: Async invocation
print("\n=== Method 7: Async Invocation ===")
async def async_translate():
    chain = prompt | llm
    result = await chain.ainvoke({
        "input_language": "English",
        "output_language": "German",
        "input": "I love programming."
    })
    print(f"Async result: {result.content}")

# Run the async function
asyncio.run(async_translate())

# Method 8: Streaming response
print("\n=== Method 8: Streaming Response ===")
chain = prompt | llm
stream = chain.stream({
    "input_language": "English",
    "output_language": "German", 
    "input": "I love programming."
})
print("Streaming response: ", end="")
for chunk in stream:
    print(chunk.content, end="", flush=True)
print()

# Method 9: Using with_config for custom settings
print("\n=== Method 9: With Config ===")
chain = prompt | llm
result = chain.with_config({"max_concurrency": 1}).invoke({
    "input_language": "English",
    "output_language": "German",
    "input": "I love programming."
})
print(result.content)

# Method 10: Function-based approach
print("\n=== Method 10: Function-based Approach ===")
def translate_text(input_language: str, output_language: str, text: str) -> str:
    """Function wrapper around the chain"""
    chain = prompt | llm
    result = chain.invoke({
        "input_language": input_language,
        "output_language": output_language,
        "input": text
    })
    return result.content

translation = translate_text("English", "German", "I love programming.")
print(translation)

# Method 11: Using RunnableParallel for multiple outputs
print("\n=== Method 11: Parallel Processing ===")
from langchain_core.runnables import RunnableParallel

# Create multiple translation chains
german_chain = prompt | llm
french_prompt = ChatPromptTemplate.from_messages([
    ("system", "You are a helpful assistant that translates {input_language} to French."),
    ("human", "{input}"),
])
french_chain = french_prompt | llm

# Run them in parallel
parallel_chain = RunnableParallel(
    german=german_chain,
    french=french_chain
)

results = parallel_chain.invoke({
    "input_language": "English",
    "input": "I love programming."
})
print(f"German: {results['german'].content}")
print(f"French: {results['french'].content}")

# Method 12: Using assign for adding context
print("\n=== Method 12: Using Assign ===")
from langchain_core.runnables import RunnablePassthrough

chain = (
    RunnablePassthrough.assign(
        formatted_input=lambda x: f"Text to translate: '{x['input']}'"
    )
    | prompt
    | llm
)

result = chain.invoke({
    "input_language": "English",
    "output_language": "German",
    "input": "I love programming."
})
print(result.content)

# Method 13: Creating a custom Runnable class
print("\n=== Method 13: Custom Runnable Class ===")
from langchain_core.runnables import Runnable
from typing import Dict, Any

class TranslationChain(Runnable):
    def __init__(self, llm, prompt):
        self.llm = llm
        self.prompt = prompt
    
    def invoke(self, input: Dict[str, Any]) -> str:
        formatted_prompt = self.prompt.format_prompt(**input)
        result = self.llm.invoke(formatted_prompt.to_messages())
        return result.content

custom_chain = TranslationChain(llm, prompt)
result = custom_chain.invoke({
    "input_language": "English",
    "output_language": "German",
    "input": "I love programming."
})
print(result)
